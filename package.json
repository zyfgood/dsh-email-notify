{
  "name": "@zyfgood/dsh-email-notify",
  "version": "0.2.0",
  "description": "DeepSeek Harness 插件：SMTP 邮件收发通知 — 注册 email_send（发信）与 email_check（IMAP 收信）两个模型工具，供 agent 汇报任务结果、定时任务通知、阅读/汇总收件邮件；凭证 env 引用不落盘，IMAP 主机按 SMTP 域名自动推导",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node tests/smoke.mjs",
    "prepack": "tsc"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "email",
    "smtp",
    "imap",
    "notification",
    "dsh-plugin"
  ],
  "dependencies": {
    "imapflow": "^2.10.2",
    "mailparser": "^3.14.2",
    "nodemailer": "^9.0.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zyfgood/dsh-email-notify.git"
  },
  "homepage": "https://github.com/zyfgood/dsh-email-notify#readme",
  "bugs": {
    "url": "https://github.com/zyfgood/dsh-email-notify/issues"
  }
}
